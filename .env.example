# Copy to .env.local and fill in. NEVER commit real keys. See docs/AI.md.

# --- AI provider -----------------------------------------------------------
# auto (default): Claude when ANTHROPIC_API_KEY is set, else Gemini when GEMINI_API_KEY is set.
RESPAWN_AI_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Claude models (defaults chosen for the ~€95 budget, see docs/GAME_DESIGN.md §10)
RESPAWN_NARRATOR_MODEL=claude-haiku-5-5
RESPAWN_FINALE_MODEL=claude-opus-5-5
# low | medium | high (default low for both)
# RESPAWN_NARRATOR_EFFORT=low
# RESPAWN_FINALE_EFFORT=low

# Gemini models (used only when the provider is gemini)
RESPAWN_GEMINI_NARRATOR_MODEL=gemini-3.5-flash-lite
RESPAWN_GEMINI_FINALE_MODEL=gemini-4-hydrogen
# minimal | low | medium | high
# RESPAWN_GEMINI_NARRATOR_THINKING=minimal
# RESPAWN_GEMINI_FINALE_THINKING=low

# --- Guards (optional) -------------------------------------------------------
# RESPAWN_RATE_PER_MIN=240     # per IP; a whole promo can share one campus IP
# RESPAWN_RATE_BURST=80
# RESPAWN_LIFE_CAP=50          # server-side calls per life (client stops at 45)
# RESPAWN_ALLOWED_ORIGINS=     # extra CORS origins, comma-separated

# --- Frontend (baked into the build) -----------------------------------------
# Default /api/ai (Vite dev server, Vercel). GitHub Pages build:
# VITE_AI_BASE_URL=https://<project-ref>.supabase.co/functions/v1/respawn-ai

# --- Promo live mode storage (optional) ---------------------------------------
# Set automatically inside Supabase Edge Functions. RESPAWN_STATS=off disables it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
